# GLM-5.3-Flash-Uncensored-NVFP4 served by SparkLab's native engine (not vLLM).
# Routed experts stay in the source NVFP4 values, stored as FTW expert banks on the
# internal NVMe and streamed into a bounded GPU expert cache.
GLM53_MODEL=/home/th0rgal/models/GLM-5.3-Flash-Uncensored-NVFP4-FTW
GLM53_SERVED_NAME=glm-5.3-flash
GLM53_PORT=8001
# Fraction of the free unified memory at startup the engine may use (weights + expert
# cache + KV). The rest is reserved for the OS, vllm-asr and page cache. Recipe: 0.96.
GLM53_MEMORY_RATIO=0.88
# Modest context, one request at a time.
# KV holds ~9000 tokens at memory ratio 0.88.
GLM53_MAX_SEQ_LEN=8192
GLM53_MAX_RUNNING=1
FREETOKEN_DISK_READ_WORKERS=16
SPARKLAB_DISK_READ_WORKERS=16
SPARKLAB_DIST_PORT=8011
# Image input: vision tower read from the source checkpoint (model.visual.*, BF16, ~1.1 GiB
# on the GPU). Empty = text-only. Token budget per image (checkpoint default 16..8000).
GLM53_VISION_MODEL=/home/th0rgal/models/GLM-5.3-Flash-Uncensored-NVFP4
GLM53_IMAGE_MAX_TOKENS=1024
